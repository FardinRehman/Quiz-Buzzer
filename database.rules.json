{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        // A user can read their own profile, or an admin can read any user profile
        ".read": "auth != null && (auth.uid === $uid || auth.token.role === 'admin')",
        // Only admins can write or modify user records, preventing role elevation
        ".write": "auth != null && auth.token.role === 'admin'",
        ".validate": "newData.hasChildren(['displayName', 'email', 'role', 'accountStatus'])",
        "role": {
          ".validate": "newData.val() === 'admin' || newData.val() === 'student'"
        },
        "accountStatus": {
          ".validate": "newData.val() === 'active' || newData.val() === 'disabled'"
        }
      }
    },

    "questionBank": {
      // Protected: Question Bank and Answer Keys are strictly accessible by authorized admins only
      ".read": "auth != null && auth.token.role === 'admin'",
      ".write": "auth != null && auth.token.role === 'admin'"
    },

    "studentScores": {
      "$uid": {
        // Privacy requirement: each student can only read their own private score & history
        ".read": "auth != null && (auth.uid === $uid || auth.token.role === 'admin')",
        // Students MUST NEVER write or modify scores directly
        ".write": "auth != null && auth.token.role === 'admin'"
      }
    },

    "publicLeaderboard": {
      // Public rankings (total Crypto, rank, wins) are visible to all authenticated contestants
      ".read": "auth != null",
      // Only admin or Cloud Function can mutate leaderboard
      ".write": "auth != null && auth.token.role === 'admin'"
    },

    "scoreLedger": {
      // Immutable transaction audit ledger
      ".read": "auth != null && auth.token.role === 'admin'",
      ".write": "auth != null && auth.token.role === 'admin'"
    },

    "sessions": {
      // Authenticated contestants can list or read active sessions
      ".read": "auth != null",

      "$sessionId": {
        // Only admins can create, update, or delete sessions
        ".write": "auth != null && auth.token.role === 'admin'",

        "rounds": {
          "$roundId": {
            // Correct answer is hidden from student read until isAnswerRevealed is true
            "correctAnswer": {
              ".read": "auth != null && (auth.token.role === 'admin' || data.parent().child('isAnswerRevealed').val() === true)"
            },

            // Contestants array & positions MUST NEVER be written directly by students
            "contestants": {
              ".write": "auth != null && auth.token.role === 'admin'"
            },
            "winnerUid": {
              ".write": "auth != null && auth.token.role === 'admin'"
            },
            "status": {
              ".write": "auth != null && auth.token.role === 'admin'"
            },

            "attempts": {
              "$attemptUid": {
                // Students can only read their own attempt record
                ".read": "auth != null && (auth.uid === $attemptUid || auth.token.role === 'admin')",
                // Writes to attempts are strictly mediated through server/Cloud Function
                ".write": "auth != null && auth.token.role === 'admin'"
              }
            }
          }
        },

        "participants": {
          "$participantUid": {
            // Students can record their own presence/join state
            ".read": "auth != null",
            ".write": "auth != null && (auth.uid === $participantUid || auth.token.role === 'admin')"
          }
        }
      }
    }
  }
}
